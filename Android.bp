soong_namespace {
    imports: [
        "hardware/qcom-caf/msm8998",
    ],
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wlan_mac.bin",
    symlink_target: "/data/vendor/wifi/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

prebuilt_hidl_interfaces {
    name: "hidl_modemswitcher_interface",
    interfaces: [
        "vendor.somc.hardware.modemswitcher@1.0::IModemSwitcher",
    ],
}
