cc_library_shared {
    name: "libmmlib2d_interface",

    srcs: [
        "src/mm_lib2d.c",
    ],

    header_libs: [
        "camera_common_headers",
        "generated_kernel_headers",
        "libutils_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "libion",
        "liblog",
        "libmmcamera_interface",
    ],

    cflags: [
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-compound-token-split-by-macro",
        "-DUSE_ION",
    ],

    include_dirs: [
        "system/memory/libion/include",
        "system/memory/libion/kernel-headers",
    ],

    local_include_dirs: [
        "inc",
    ],

    vendor: true,
}
