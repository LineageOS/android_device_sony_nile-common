cc_library_shared {
    name: "libhal_dbg",

    srcs: [
        "fdleak.cpp",
        "memleak.cpp",
    ],

    header_libs: [
        "libmmcamera_interface_headers",
    ],

    shared_libs: [
        "libdl",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-D_ANDROID",
        "-Werror",
        "-Wunused-parameter",
    ],

    export_include_dirs: [
        ".",
    ],

    vendor: true,
}
